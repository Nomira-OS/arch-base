# Everything that determines the content of the image. One date rules: the
# date in the tag of ARCH_IMAGE. hack/build-args.sh derives the Arch Linux
# Archive snapshot and SOURCE_DATE_EPOCH from it. Renovate updates all three
# lines; it pins ARCH_IMAGE by digest and keeps the tag readable.
ARCH_IMAGE=docker.io/archlinux/archlinux:base-20261122.0.629543
BOOTC_REF=v1.17.4
NOMIRA_CLI_REF=d717f4d08d7739561314d5dd2291f2a4e0da7988
