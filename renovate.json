{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Nomira-OS/ci"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Dated Arch Linux base image in versions.env; its date is the archive snapshot",
      "managerFilePatterns": [
        "/^versions\\.env$/"
      ],
      "matchStrings": [
        "ARCH_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^base-(?<major>\\d{8})\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "bootc tag in versions.env",
      "managerFilePatterns": [
        "/^versions\\.env$/"
      ],
      "matchStrings": [
        "BOOTC_REF=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "bootc-dev/bootc"
    },
    {
      "customType": "regex",
      "description": "nomira-cli commit in versions.env, following main",
      "managerFilePatterns": [
        "/^versions\\.env$/"
      ],
      "matchStrings": [
        "NOMIRA_CLI_REF=(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "nomira-cli",
      "packageNameTemplate": "https://github.com/Nomira-OS/nomira-cli"
    }
  ],
  "packageRules": [
    {
      "description": "Pin the Arch base image by digest as well; the tag stays for readability",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "docker.io/archlinux/archlinux"
      ],
      "pinDigests": true
    }
  ]
}
