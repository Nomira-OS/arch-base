
# The triggers above are those of Arch's dracut hooks, which nomira masks:
# they write a host-specific initramfs to /boot. This action keeps the one
# bootc boots instead, /usr/lib/modules/<kver>/initramfs.img, built with
# the configuration in /usr/lib/dracut/dracut.conf.d (not host-specific,
# reproducible with SOURCE_DATE_EPOCH), and removes it with its kernel.
# /usr/lib/nomira/initramfs skips dracut when a recipe's cache holds an
# initramfs built from the same files.
[Action]
Description = Updating the initramfs in /usr/lib/modules (nomira)...
When = PostTransaction
Exec = /usr/lib/nomira/initramfs
