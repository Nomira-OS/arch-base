#!/bin/sh
# Runs pacman and tries again when it fails, for instance because the Arch
# Linux Archive answers too slowly. Packages already downloaded stay in the
# cache, so a retry only fetches what is missing.
for wait in 30 90 0; do
    pacman "$@" && exit 0
    [ "$wait" = 0 ] && exit 1
    echo "pacman failed; trying again in ${wait}s" >&2
    sleep "$wait"
done
