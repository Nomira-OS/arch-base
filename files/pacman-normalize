#!/bin/sh
# Removes what makes a pacman transaction depend on when it ran: the
# install date of every package becomes SOURCE_DATE_EPOCH, and the log and
# the package cache are removed. Run at the end of every RUN that calls
# pacman, so the layer never contains the original values.
set -eu
: "${SOURCE_DATE_EPOCH:?SOURCE_DATE_EPOCH is not set}"
db="$(pacman-conf DBPath)"
for desc in "${db%/}"/local/*/desc; do
    awk -v t="$SOURCE_DATE_EPOCH" \
        'fix { print t; fix = 0; next } /^%INSTALLDATE%$/ { fix = 1 } { print }' \
        "$desc" > "$desc.new"
    cat "$desc.new" > "$desc"
    rm "$desc.new"
done
rm -f "$(pacman-conf LogFile)"
pacman -Scc --noconfirm > /dev/null
